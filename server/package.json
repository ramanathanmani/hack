{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy-migrations",
    "copy-migrations": "mkdir -p dist/server/src/db/migrations && cp src/db/migrations/*.sql dist/server/src/db/migrations/",
    "start": "NODE_ENV=production node dist/server/src/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:chain": "tsx --test test/chain.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "reset": "rm -f ../data/sentinel.db && npm run seed",
    "verify-chain": "tsx scripts/verify-chain.ts",
    "tamper": "tsx scripts/tamper.ts"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/static": "^8.0.3",
    "ws": "^8.18.0",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

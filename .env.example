# Sentinel — env vars. Every var has a working default; .env is optional.
# No secrets exist in this project (architecture.md §6/§7 — no auth, no API keys).

# HTTP + WS port
PORT=8080
# Bind address
HOST=127.0.0.1
# development | production (production enables static serving of web/dist)
NODE_ENV=development
# SQLite file path
SENTINEL_DB_PATH=./data/sentinel.db
# Deterministic PRNG seed (AC-12)
SIM_SEED=20261009
# Telemetry tick interval, ms
SIM_TICK_MS=1000
# Number of centers (default 8; floor 6 per cut-list item 6)
SIM_CENTERS=8
# Visible candidate sessions per center
SIM_SESSIONS_PER_CENTER=3
# Simulated exam length, seconds
EXAM_DURATION_S=3600
# Partial-extension threshold, seconds (A4)
VERDICT_FREEZE_THRESHOLD_S=10
# Re-conduct threshold, seconds
VERDICT_RECONDUCT_THRESHOLD_S=600
# Illustrative re-conduct cost input, INR per candidate
VERDICT_COST_PER_CANDIDATE_INR=850
# Gates kill/reconnect/tamper routes under /api/sim
ENABLE_SIM_CONTROLS=true
